# Copy to .env (gitignored) and fill in.
# v1 snapshot tokens for `npm run fetch-data` (see DEPLOY.md "Loading Sheets data").
# Each came from running setupDevDumpToken() once in that environment's Apps Script
# editor. Delete both after the v2.0.0 cutover archives the Apps Script deployments.
DEV_DUMP_TOKEN=
DEV_DUMP_TOKEN_DEV=
# Cloudflare account that owns the angeloyal-oms Pages project and D1 databases.
# Needed only if your `wrangler login` can see more than one account — without it
# wrangler stops with "More than one account available". wrangler reads it straight
# out of this .env. Find it with `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=
