# Copy to .env (gitignored) and fill in.
# Get each token by running setupDevDumpToken() once in that environment's Apps Script editor.
DEV_DUMP_TOKEN=
# From the DEV script (see DEPLOY.md "Environments") — used by clear-data and fetch-data --dev.
DEV_DUMP_TOKEN_DEV=
# Cloudflare account that owns the angeloyal-oms Pages projects. Needed only if
# your `wrangler login` can see more than one account — without it the web half
# of `npm run release` stops with "More than one account available". wrangler
# reads it straight out of this .env. Find it with `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=
