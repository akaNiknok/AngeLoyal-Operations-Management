{
  "name": "angeloyal-operations-management",
  "private": true,
  "version": "1.0.0",
  "description": "AngeLoyal Logistics - Operations Management System (Google Apps Script)",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "login": "clasp login",
    "use:dev": "node -e \"require('fs').copyFileSync('.clasp.dev.json','.clasp.json')\"",
    "use:prod": "node -e \"require('fs').copyFileSync('.clasp.prod.json','.clasp.json')\"",
    "pull": "npm run use:prod && clasp pull",
    "push": "npm run use:dev && clasp push",
    "watch": "npm run use:dev && clasp push --watch",
    "open": "npm run use:dev && clasp open",
    "open:prod": "npm run use:prod && clasp open",
    "deploy:dev": "npm run use:dev && clasp push && clasp deploy -i AKfycbziNYgamxGPl7B8OVB1YYb1bZ2VZEdb9RC59pTEtUzSOeVNxAZCVtMc-6jJrqmdk26XgQ",
    "release": "npm run use:prod && clasp push --force && clasp deploy -i AKfycby8gSa29N58Ny3mJjkDgdbnaIWUfQocPQwJ0QochAh_mLDsmYslJaO0ANDCbuXYNYV0",
    "deployments": "clasp deployments",
    "logs": "clasp logs",
    "fetch-data": "node scripts/fetch-sheet-data.js",
    "clear-data": "node scripts/clear-sheet-data.js",
    "clear-data:prod": "node scripts/clear-sheet-data.js --prod",
    "backlog:seed": "node scripts/seed-github-issues.mjs",
    "backlog:sync": "node scripts/sync-backlog.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  }
}
